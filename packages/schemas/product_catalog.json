{
  "version": "1.0.0",
  "description": "Product catalog schema for opportunity research",
  "Product": {
    "sku": "string (required)",
    "name": "string (required)",
    "category": "string (required)",
    "subcategory": "string",
    "country": "string (required)",
    "supplier_id": "string",
    "supplier_name": "string",
    "gtin": "string",
    "brand": "string",
    "mpn": "string",
    "wholesale_price": "number (required)",
    "selling_price": "number (required)",
    "shipping_cost": "number (required)",
    "currency": "string (default: USD)",
    "search_volume": "number",
    "competition_score": "number (0-1)",
    "source": "string",
    "grade": "string (A+ to C)",
    "created_at": "datetime",
    "updated_at": "datetime"
  },
  "EconomicModel": {
    "product_sku": "string (required)",
    "landed_cost": "number",
    "selling_price": "number",
    "pre_ad_contribution": "number",
    "payment_fees": "number",
    "expected_refunds": "number",
    "expected_cvr": "number",
    "expected_cpc": "number",
    "break_even_cvr": "number",
    "break_even_cpc": "number",
    "expected_profit_per_click": "number",
    "economic_headroom": "number",
    "confidence": "string (STRONG|INTERESTING|MARGINAL|WEAK)"
  },
  "OpportunityScore": {
    "product_sku": "string (required)",
    "score": "number (0-100)",
    "confidence": "string",
    "tags": "array of strings",
    "why_it_might_work": "string",
    "why_it_might_fail": "string",
    "largest_unknown": "string",
    "cheapest_way_to_test": "string"
  }
}
