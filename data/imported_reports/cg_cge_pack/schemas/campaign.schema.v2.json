{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Drop Campaign Hypothesis v2",
  "type": "object",
  "required": [
    "campaign_id",
    "schema_version",
    "track",
    "country",
    "atom",
    "buyer_route",
    "supplier_strategy",
    "distribution_strategy",
    "evidence_requirements",
    "experiment"
  ],
  "properties": {
    "campaign_id": {
      "type": "string"
    },
    "schema_version": {
      "const": "2.0"
    },
    "track": {
      "enum": [
        "D2C_COMPATIBILITY_COMMERCE",
        "D2C_MIGRATION_BUNDLE",
        "SERVICE_ORCHESTRATION",
        "B2B_RESOLUTION",
        "BENCHMARK"
      ]
    },
    "country": {
      "type": "string",
      "minLength": 2,
      "maxLength": 2
    },
    "language": {
      "type": [
        "string",
        "null"
      ]
    },
    "atom": {
      "type": "object",
      "required": [
        "oem_ecosystem",
        "asset",
        "generation_scope",
        "component_scope",
        "triggers"
      ],
      "properties": {
        "oem_ecosystem": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "asset": {
          "type": "string"
        },
        "generation_scope": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "component_scope": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "triggers": {
          "type": "array",
          "items": {
            "enum": [
              "FAILURE",
              "CONSUMABLE",
              "MAINTENANCE",
              "OBSOLESCENCE",
              "SUCCESSOR_MIGRATION"
            ]
          },
          "minItems": 1
        }
      }
    },
    "buyer_route": {
      "type": "object",
      "required": [
        "problem_noticer",
        "diagnoser",
        "sku_selector",
        "payer",
        "installer"
      ],
      "properties": {
        "problem_noticer": {
          "type": [
            "string",
            "null"
          ]
        },
        "diagnoser": {
          "type": [
            "string",
            "null"
          ]
        },
        "sku_selector": {
          "type": [
            "string",
            "null"
          ]
        },
        "payer": {
          "type": [
            "string",
            "null"
          ]
        },
        "installer": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "supplier_strategy": {
      "type": "object",
      "required": [
        "candidate_supplier_ids",
        "transaction_route"
      ],
      "properties": {
        "candidate_supplier_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "transaction_route": {
          "enum": [
            "RESELL",
            "DIRECT_SHIP",
            "AFFILIATE",
            "REFERRAL",
            "RFQ_PO",
            "REPAIR_EXCHANGE",
            "UNKNOWN"
          ]
        }
      }
    },
    "distribution_strategy": {
      "type": "object",
      "properties": {
        "google_merchant_center": {
          "type": "boolean"
        },
        "shopify_catalog": {
          "type": "boolean"
        },
        "web_jsonld": {
          "type": "boolean"
        },
        "rfq_api": {
          "type": "boolean"
        },
        "service_booking": {
          "type": "boolean"
        }
      }
    },
    "evidence_bindings": {
      "type": "object",
      "description": "Populated by evidence compiler, not proposer.",
      "readOnly": true,
      "properties": {
        "evidence_snapshot_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "evidence_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "experiment": {
      "type": "object",
      "required": [
        "resolver_cases",
        "incumbent_cases",
        "success_rules",
        "kill_rules"
      ],
      "properties": {
        "resolver_cases": {
          "type": "integer",
          "minimum": 1
        },
        "incumbent_cases": {
          "type": "integer",
          "minimum": 1
        },
        "success_rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kill_rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}