{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Backtest",
  "type": "object",
  "required": [
    "backtest_id",
    "country",
    "strategy_id",
    "strategy_version",
    "class",
    "as_of",
    "candidate_universe_ref",
    "evidence_snapshot_refs",
    "metrics",
    "leakage_check"
  ],
  "properties": {
    "class": {
      "enum": [
        "TRUE_HISTORICAL",
        "RECONSTRUCTED_HISTORICAL",
        "PROSPECTIVE_SHADOW"
      ]
    }
  },
  "additionalProperties": true
}
