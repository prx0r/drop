{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GeoDrop Segment",
  "type": "object",
  "required": [
    "segment_id",
    "country",
    "name",
    "state",
    "thesis",
    "evidence_refs",
    "falsifiers"
  ],
  "properties": {
    "segment_id": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "thesis": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "falsifiers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "seed_queries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
