{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Problem",
  "type": "object",
  "required": [
    "problem_id",
    "ecosystem_id",
    "country",
    "name",
    "trigger_types",
    "evidence_status"
  ],
  "properties": {
    "problem_id": {
      "type": "string"
    },
    "ecosystem_id": {
      "type": "string"
    },
    "trigger_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
