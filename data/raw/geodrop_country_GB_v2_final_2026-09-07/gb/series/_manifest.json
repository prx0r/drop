{
  "version": "2.0.0",
  "series": [
    {
      "file": "installed_base.csv",
      "grain": [
        "date",
        "country",
        "ecosystem_id",
        "metric"
      ],
      "rows_seeded": 5,
      "append_only": true,
      "point_in_time_required": true
    },
    {
      "file": "problem_incidence.csv",
      "grain": [
        "date",
        "country",
        "ecosystem_id",
        "problem_id"
      ],
      "rows_seeded": 3,
      "append_only": true,
      "point_in_time_required": true
    },
    {
      "file": "search.csv",
      "grain": [
        "measured_at",
        "country",
        "query_id",
        "language"
      ],
      "rows_seeded": 0,
      "append_only": true,
      "point_in_time_required": true
    },
    {
      "file": "imports.csv",
      "grain": [
        "period",
        "country",
        "ecosystem_id",
        "code_system"
      ],
      "rows_seeded": 0,
      "append_only": true,
      "point_in_time_required": true
    },
    {
      "file": "seller_snapshots.csv",
      "grain": [
        "snapshot_at",
        "country",
        "ecosystem_id",
        "product_market_id"
      ],
      "rows_seeded": 0,
      "append_only": true,
      "point_in_time_required": true
    },
    {
      "file": "price_snapshots.csv",
      "grain": [
        "snapshot_at",
        "country",
        "product_market_id",
        "sku"
      ],
      "rows_seeded": 0,
      "append_only": true,
      "point_in_time_required": true
    },
    {
      "file": "supplier_snapshots.csv",
      "grain": [
        "snapshot_at",
        "country",
        "product_market_id",
        "supplier"
      ],
      "rows_seeded": 0,
      "append_only": true,
      "point_in_time_required": true
    },
    {
      "file": "macro.csv",
      "grain": [
        "period",
        "country",
        "metric",
        "value"
      ],
      "rows_seeded": 5,
      "append_only": true,
      "point_in_time_required": true
    },
    {
      "file": "experiment_metrics.csv",
      "grain": [
        "timestamp",
        "experiment_id",
        "variant",
        "sku"
      ],
      "rows_seeded": 0,
      "append_only": true,
      "point_in_time_required": true
    }
  ],
  "rule": "Never overwrite historical rows. Corrections append corrected records with metadata/raw snapshot linkage in production ingestion."
}
