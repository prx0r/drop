{
  "classes": [
    "TRUE_HISTORICAL",
    "RECONSTRUCTED_HISTORICAL",
    "PROSPECTIVE_SHADOW"
  ],
  "true_historical_rule": "all required evidence available_at <= as_of and strategy version frozen",
  "unknown_available_at": "not_point_in_time_safe",
  "required_logs": [
    "candidate_universe",
    "ranking",
    "strategy_version",
    "evidence_refs",
    "raw_snapshot_hashes",
    "predictions",
    "outcomes"
  ],
  "metrics": [
    "precision_at_k",
    "validation_hit_rate",
    "false_positive_rate_by_reason",
    "time_to_falsification",
    "capital_per_validated_winner",
    "median_realized_contribution",
    "brier_score_if_probabilistic",
    "rank_correlation"
  ]
}
